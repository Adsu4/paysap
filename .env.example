# Copy to .env and fill every required value before running in production.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Use 'loopback' behind local NGINX, or '1' behind PaaS proxies (Heroku / Azure App Service)
TRUST_PROXY=loopback
APP_URL=https://paysap.me

# Required: generate each separately with openssl rand -hex 32.
# Keep a secure recovery copy: losing the encryption key loses stored mailbox tokens.
ENCRYPTION_KEY=
WEBHOOK_SHARED_SECRET=

# Persistence driver: 'postgres' (recommended for production) or 'json' (local pilot/demo).
# When DATABASE_URL is set and STORAGE_DRIVER is omitted, PostgreSQL is used automatically.
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/paysap?sslmode=require

# Fallback JSON data directory (when STORAGE_DRIVER=json or DATABASE_URL is unset).
DATA_DIR=/var/www/paysap/data

# Optional webhook URL to deliver owner password-reset tokens.
# PASSWORD_RESET_WEBHOOK_URL=

# Optional Gmail integration. Omit until configured and approved for intended use.
# gmail.readonly is restricted; verification/assessment is a separate launch dependency.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://paysap.me/api/auth/google/callback

# Optional: comma-separated account IDs for the platform OAuth-config administrator.
# PLATFORM_ADMIN_SELLER_IDS=

# Tests set DISABLE_BANK_POLLING=1 in their own isolated child process.
# Also usable deliberately during a supervised pilot without mailbox polling.
# DISABLE_BANK_POLLING=1

# Legacy default for stores without an explicit confirmation choice.
# Owners can select review or automatic confirmation in Settings > UPI & Banking;
# that per-store choice takes precedence. New stores default to owner review.
ENABLE_EMAIL_AUTO_CONFIRMATION=0

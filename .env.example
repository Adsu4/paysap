# ==============================================================================
# PaySap Production Environment Configuration Template
# Copy to `.env` on your deployment server: cp .env.example .env
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# Base Application URL (Required for direct payment link generation & Google OAuth callback)
APP_URL=https://paysap.me

# Master AES-256-GCM Encryption Key (Must be exactly 32 bytes / 32 characters or 64 hex chars)
# Used to encrypt merchant IMAP passwords and Google OAuth tokens at rest on disk/database
ENCRYPTION_KEY=01234567890123456789012345678901

# Session & JWT Secret (Random 32+ character string)
SESSION_SECRET=super_secret_session_signing_key_replace_in_production_2026

# Database Connection (Neon / Supabase PostgreSQL URL)
# Free tier PostgreSQL from GitHub Student Pack
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/paysap?sslmode=require

# Google Cloud OAuth 2.0 Credentials (For 1-Click Automated Gmail Bank Alert Ingestion)
# Set up at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://paysap.me/api/auth/google/callback

# Inbound Bank Alert Ingestion Secret (HMAC secret for Cloudflare Email Worker / Cloudmailin)
WEBHOOK_SHARED_SECRET=your_secret_hmac_key_for_bank_email_forwarding

# Optional: Sentry Error Monitoring DSN (Free 50k events/month via Student Pack)
SENTRY_DSN=

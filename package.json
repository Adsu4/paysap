{
  "name": "boutique-paylink",
  "version": "1.0.0",
  "description": "WhatsApp Micro-Link Checkout & Automated Dispatch for Retail Merchants",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o public/css/tailwind.css --minify",
    "test": "node --test tests/regression.test.js tests/themes.test.js tests/mailbox.test.js tests/features_and_security.test.js",
    "migrate": "node scripts/migrate_json_to_postgres.js",
    "demo": "node scripts/preview-demo.js"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
